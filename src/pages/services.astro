---
import MainLayout from '@/layouts/MainLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';

const services = [
  {
    number: '01',
    title: 'Applications web & outils métier sur mesure',
    descriptions: [
      "Je conçois des applications web adaptées à votre activité : dashboards, back-offices et outils internes permettant de gérer vos données, vos clients ou certains processus métier. L'objectif est de transformer des tâches dispersées ou manuelles en une interface claire, performante et facile à faire évoluer.",
      'Ces applications peuvent par exemple servir à centraliser des informations, suivre des clients, gérer du contenu ou organiser certaines opérations internes.',
    ],
    canBuild: [
      "dashboards de suivi d'activité",
      'back-offices de gestion de contenu ou de données',
      'outils internes pour équipes ou indépendants',
      'interfaces pour gérer clients, projets ou leads',
    ],
    idealFor: [
      'vous utilisez plusieurs outils ou fichiers pour gérer votre activité',
      'certaines tâches sont encore manuelles ou dispersées',
      "vous avez besoin d'un outil adapté à votre manière de travailler",
    ],
    tags: ['Applications', 'Dashboards', 'Back-offices', 'Outils internes', 'Automatisation', 'Process'],
  },
  {
    number: '02',
    title: 'Sites web stratégiques',
    descriptions: [
      "Je conçois des sites web pensés comme de véritables outils de crédibilité et de conversion. L'objectif est de présenter clairement votre activité, structurer votre message et créer une présence en ligne qui inspire confiance à vos clients, partenaires ou investisseurs.",
      "Chaque site est conçu pour être lisible, rapide et facile à faire évoluer, avec une attention particulière portée à la structure de l'information et à l'expérience utilisateur.",
    ],
    canBuild: [
      'sites professionnels pour entreprises ou indépendants',
      'sites B2B destinés à présenter une activité ou des réalisations',
      'refonte de sites existants pour clarifier le positionnement',
      'pages clés destinées à présenter un produit ou un service',
    ],
    idealFor: [
      'votre site actuel ne reflète plus la qualité de votre activité',
      "vous avez besoin d'une présence en ligne claire et crédible",
      'vous souhaitez mieux présenter votre offre ou vos réalisations',
    ],
    tags: ['Sites web', 'Crédibilité', 'B2B', 'Refonte', 'UX'],
  },
  {
    number: '03',
    title: 'Interfaces orientées produit',
    descriptions: [
      "Je conçois des interfaces pensées pour l'utilisation réelle d'un produit ou d'une application. L'objectif est de rendre les fonctionnalités claires, fluides et agréables à utiliser, en combinant structure d'interface, interactions et attention aux détails.",
    ],
    canBuild: [
      'interfaces pour produits web ou applications',
      "composants interactifs et systèmes d'interface",
      "amélioration de l'ergonomie d'un produit existant",
      "interactions et micro-animations utiles à l'expérience",
    ],
    idealFor: [
      'votre produit web devient plus complexe et nécessite une interface claire',
      'certaines fonctionnalités sont difficiles à comprendre pour les utilisateurs',
      "vous souhaitez améliorer l'expérience et la fluidité de votre interface",
    ],
    tags: ['Produit', 'UI', 'Interactions', 'Composants', 'UX'],
  },
];

const audiences = [
  { label: 'Startups', desc: "Qui ont besoin d'un front-end solide pour lancer ou faire évoluer leur produit." },
  { label: 'Studios & agences', desc: 'Qui cherchent un développeur front-end de confiance pour compléter leur équipe.' },
  { label: 'Indépendants & marques', desc: 'Qui veulent un site web premium qui reflète la qualité de leur travail.' },
  { label: 'PME', desc: 'Qui souhaitent moderniser leur présence web avec une vraie attention au design.' },
];
---

<MainLayout
  title="Services — Axel, développeur freelance React & TypeScript"
  description="Développement front-end React/TypeScript, sites web orientés UX, et expériences interactives sur mesure."
  noindex={true}
>
  <!-- Hero -->
  <section class="py-24 border-b border-border">
    <Container>
      <div class="reveal mb-10">
        <SectionLabel label="Services" class="mb-8" />
        <h1 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-ink leading-[1.1] max-w-[700px]">
          Ce que je construis<br />
          <span class="text-accent">pour vous.</span>
        </h1>
      </div>
      <p class="reveal text-base text-ink-muted leading-relaxed max-w-[520px]">
        Je conçois des applications web sur mesure pensées pour soutenir des objectifs réels :
        organiser l’information, simplifier des processus et créer des expériences claires pour les utilisateurs.
      </p>
    </Container>
  </section>

  <!-- Services -->
  <section class="py-24">
    <Container>
      <div class="flex flex-col gap-6">
        {services.map((service) => (
          <div class="reveal bg-bg-2 border border-border p-8 md:p-10 hover:border-accent transition-colors duration-150">
            <div class="flex items-start justify-between mb-6">
              <span class="font-mono text-xs text-accent">{service.number}</span>
              <div class="flex flex-wrap gap-1.5 justify-end">
                {service.tags.map((tag) => (
                  <span class="font-mono text-xs text-ink border border-border px-2 py-1">{tag}</span>
                ))}
              </div>
            </div>

            <h3 class="font-display font-semibold text-3xl md:text-4xl text-ink mb-4 leading-tight">
              {service.title}
            </h3>

            {service.descriptions.map((paragraph, i) => (
              <p class={`text-base text-ink-muted leading-relaxed max-w-[640px] ${i < service.descriptions.length - 1 ? 'mb-4' : 'mb-8'}`}>
                {paragraph}
              </p>
            ))}

            <div class="grid md:grid-cols-2 gap-8 border-t border-border pt-8">
              <div>
                <p class="font-mono text-xs text-accent uppercase tracking-widest mb-4">Ce que je peux construire</p>
                <ul class="space-y-2.5">
                  {service.canBuild.map((item) => (
                    <li class="flex items-start gap-3 text-base text-ink-muted">
                      <span class="text-accent shrink-0 font-mono mt-0.5">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="font-mono text-xs text-accent uppercase tracking-widest mb-4">Idéal si</p>
                <ul class="space-y-2.5">
                  {service.idealFor.map((item) => (
                    <li class="flex items-start gap-3 text-base text-ink-muted">
                      <span class="text-accent shrink-0 font-mono mt-0.5">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Pour qui je travaille -->
  <section class="py-20 border-t border-border border-b">
    <Container>
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <h2 class="font-display font-semibold text-3xl md:text-4xl text-ink leading-tight">
            Pour qui je travaille
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 gap-8">
          {audiences.map((a, i) => (
            <div class="reveal" style={`transition-delay: ${i * 0.08}s`}>
              <h3 class="font-sans text-sm font-medium text-ink mb-2">{a.label}</h3>
              <p class="text-sm text-ink-2 leading-relaxed">{a.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="py-24">
    <Container>
      <div class="reveal text-center max-w-[520px] mx-auto">
        <h2 class="font-display font-semibold text-4xl text-ink mb-6">
          Un besoin en tête ?
        </h2>
        <p class="text-sm text-ink-2 leading-relaxed mb-8">
          Décrivez-moi votre projet. Je vous reviens sous 12h pour voir si on peut travailler ensemble.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-3 font-sans font-medium text-sm bg-accent text-bg px-8 py-4 hover:opacity-90 transition-opacity duration-150"
        >
          Me contacter
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Container>
  </section>
</MainLayout>
