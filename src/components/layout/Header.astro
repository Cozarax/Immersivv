---
const navLinks = [
  { href: '/#projets', label: 'Projets' },
  { href: '/#a-propos', label: 'À propos' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50">
  <div class="max-w-[1200px] mx-auto px-6 md:px-10 h-16 flex items-center justify-center relative">

    <!-- Nom / retour accueil -->
    <a
      href="/"
      class="absolute left-6 md:left-10 font-mono text-sm text-ink-2 hover:text-ink transition-colors duration-150"
    >
      Axel
    </a>

    <!-- Nav centré -->
    <nav class="hidden md:flex items-center gap-8 px-6 py-2 rounded-full bg-white/10 backdrop-blur-md">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-sans text-sm text-ink-2 hover:text-ink transition-colors duration-150"
        >
          {link.label}
        </a>
      ))}
    </nav>

  </div>
</header>
