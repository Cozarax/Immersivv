---
import { getCollection } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);
---

<section id="projets" class="relative z-10 py-28">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-12">
      <div class="reveal">
        <SectionLabel number="01" label="Projets" class="mb-6" />
        <h2 class="font-display font-semibold text-4xl md:text-5xl text-ink leading-tight">
          Quelques projets récents
        </h2>
      </div>
      <div class="reveal">
        <a
          href="/projets"
          class="inline-flex items-center gap-2 font-mono text-2xs uppercase tracking-widest text-ink-2 hover:text-accent transition-colors duration-150"
        >
          Tous les projets
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
            <path d="M1 5h12M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>
  </Container>
</section>

<div class="max-w-[1200px] mx-auto px-6 md:px-10">
  <div class="border-t border-border"></div>
</div>
