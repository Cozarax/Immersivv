---
import Container from '@/components/ui/Container.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import HeroRotatingText from '@/components/home/HeroRotatingText';
---

<section class="relative min-h-[90vh] flex items-center">
  <!-- Contenu -->
  <Container class="pt-32 pb-24 relative z-10">
    <div class="max-w-[1060px]">

      <!-- Accroche -->
      <p class="font-mono text-sm text-ink-2 uppercase tracking-widest mb-8 fade-in" style="animation-delay: 0.05s">
        Bonjour 
      </p>

      <!-- Nom — point focal, taille maximale -->
      <h1
        class="font-display font-semibold text-2xl md:text-5xl text-ink leading-[1.05] mb-2 fade-in"
        style="animation-delay: 0.15s"
      >
        <span class="text-ink-2">Je suis</span>  Axel Cozar
      </h1>

      <!-- Rôle — avec le RotatingText, mb-16 pour compenser la hauteur absolue du badge -->
      <div class="mb-16 fade-in" style="animation-delay: 0.25s">
        <p class="font-display font-semibold text-3xl md:text-7xl text-ink leading-[1.2]">
          <span class="relative inline-block">
            Développeur
            <span class="absolute top-1/2 -translate-y-1/2 left-[calc(100%+1rem)]">
              <HeroRotatingText client:only="react" />
            </span>
          </span>
        </p>
      </div>

    </div>
    <div class="max-w-[860px]">
      <!-- Subtitle -->
      <p
        class="text-base md:text-lg text-ink-1 leading-relaxed max-w-[760px] mb-12 fade-in"
        style="animation-delay: 0.4s"
      >
        Développeur Web, je construis des applications de bout en bout : du choix de l'infrastructure et des outils jusqu'au déploiement.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-start gap-4 mb-16 fade-in" style="animation-delay: 0.55s">
        <ButtonLink href="/#projets" variant="primary" arrow>
          Voir mes projets
        </ButtonLink>
        <ButtonLink href="/#contact" variant="secondary">
          Me contacter
        </ButtonLink>
      </div>

      <!-- Tech tags
      <div class="fade-in" style="animation-delay: 0.55s">
        <TechTags client:only="react" tags={['React', 'TypeScript', 'Node.js', 'Next.js', 'PostgreSQL']} />
      </div> -->
    </div>
  </Container>
</section>
