---
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';

const skills = [
  'React',
  'TypeScript',
  'Next.js',
  'Node.js',
  'PostgreSQL / Prisma',
  'REST / GraphQL',
  'Tailwind CSS',
  'Git',
];
---

<section id="a-propos" class="py-28">
  <Container>
    <div class="reveal mb-16">
      <SectionLabel number="02" label="À propos" class="mb-6" />
    </div>

    <div class="grid md:grid-cols-2 gap-16 items-start">
      <!-- Text -->
      <div class="reveal">
        <h2 class="font-display font-semibold text-3xl md:text-4xl text-ink leading-tight mb-8">
          Je construis des interfaces avec intention.
        </h2>
        <div class="space-y-4 text-sm text-ink-2 leading-relaxed">
          <p>
            Développeur front-end et full-stack spécialisé en React et TypeScript, je travaille
            principalement sur des applications métier — dashboards, outils internes, back-offices,
            interfaces de données.
          </p>
          <p>
            Ce qui m'intéresse, c'est l'endroit où la technique rencontre l'usage réel : des
            interfaces qui permettent à des équipes de mieux travailler, pas seulement de regarder
            de beaux chiffres.
          </p>
          <p>
            Je code proprement, je pense en composants, et j'ai suffisamment de sensibilité design
            pour qu'une interface soit aussi agréable à utiliser qu'efficace à maintenir.
          </p>
        </div>
      </div>

      <!-- Skills list -->
      <div class="reveal">
        <div class="border border-border p-8">
          <p class="section-label mb-8">Stack principale</p>
          <ul class="space-y-3">
            {skills.map((skill) => (
              <li class="flex items-center gap-3 text-sm text-ink-2">
                <span class="text-accent shrink-0 font-mono text-xs">—</span>
                <span>{skill}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>

<div class="max-w-[1200px] mx-auto px-6 md:px-10">
  <div class="border-t border-border"></div>
</div>
